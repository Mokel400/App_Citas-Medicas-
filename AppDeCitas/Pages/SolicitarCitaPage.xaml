<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppDeCitas.Pages.SolicitarCitaPage"
             Title="Solicitar Cita">
    <VerticalStackLayout 
        VerticalOptions="Start"
        Padding="30"
        Margin="25">
        <Label 
            x:Name="solicitarCitaTitulo"
            Text="Solicitar cita"
            HorizontalOptions="Center"/>
        <Entry
            x:Name="Nombre"
            Placeholder="Nombre"/>
        <Entry
            x:Name="Apellido"
            Placeholder="Apellido"/>
        <Entry
            x:Name="Paciente"
            Placeholder="Número de paciente"
            Keyboard="Numeric"/>
        <HorizontalStackLayout>
            <CheckBox
                x:Name="Recordar"/>
            <Label
                x:Name="RecordarDatos"
                Text="Recordar mis datos"
                VerticalOptions="Center"/>
        </HorizontalStackLayout>
        <CollectionView x:Name="especialidades" SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width=".2*"/>
                            <ColumnDefinition Width=".6*"/>
                            <ColumnDefinition Width=".4*"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="{Binding imagen}"/>
                        <VerticalStackLayout Grid.Column="1" Padding="10,0" VerticalOptions="Center">
                            <Label Text="{Binding nombre}"
                                   FontAttributes="Bold"/>
                            <Label Text="{Binding especialista}"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout
                            Grid.Column="2"
                            Padding="10">
                            <Label
                                Text="{Binding espera}"
                                FontAttributes="Bold"/>
                            <Label Text="días de espera"/>
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>