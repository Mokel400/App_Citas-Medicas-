<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppDeCitas.MainPage">

    <ScrollView>
        <VerticalStackLayout
            VerticalOptions="Center"
            Padding="30,0"
            Spacing="25">

            <Label
                x:Name="tituloCitas"
                Text="Citas médicas"
                HorizontalOptions="Center"
                FontAttributes="Bold"/>
            <Button
                x:Name="solicitarCita"
                Text="Solicitar cita"
                Clicked="SolicitarCitaBtnClicked"/>
            <Button
                x:Name="ConsultarCita"
                Text="Consultar tus citas"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
